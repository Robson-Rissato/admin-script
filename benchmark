                # Check NVMe health, if applicable
                for i in $(lsblk | grep nvme | grep disk | awk '{print $1}'); do
                serial=$(smartctl -i /dev/$i | grep Serial | awk '{print $3}');
                disk=$(smartctl -i /dev/$i | grep -iE "Device Model|Model Number" | cut -d : -f 2 | sed -e 's/^[ \t]*//');
                speed=$(hdparm -tT /dev/$i | tail -1 | awk '{print $(NF-1)}');
                    if [ $(smartctl -a /dev/$i | grep -iE "Reallocate|Uncorrectable|Pending_Sector|Integrity Errors:" | awk '{print $NF}' | paste -sd+ | bc) -ne 0 ]; then
                        echo -e "Device:\t/dev/$i\nModel:\t$disk\nStatus:\t${red}FAILED${normal}\nSN:\t${serial}\nSpeed:\t${speed} MB/s\n"
                    else
                        if [ $(smartctl -H /dev/$i | grep 'SMART overall-health self-assessment test' | awk '{print $6}') = PASSED ]; then
                        echo -e "Device:\t/dev/$i\nModel:\t$disk\nStatus:\t${green}PASSED${normal}\nSN:\t${serial}\nSpeed:\t${speed} MB/s\n"
                        fi
                    fi
                done

                # Check drive health behind RAID card
                for i in $(MegaCli -pdlist -a0| grep -oP '(?<=Device Id: )[^ ]*'); do
                serial=$(smartctl -d sat+megaraid,$i -a /dev/sda | grep Serial | awk '{print $3}');
                disk=$(smartctl -d sat+megaraid,$i -a /dev/sda | grep -iE "Device Model|Model Number" | cut -d : -f 2 | sed -e 's/^[ \t]*//');
