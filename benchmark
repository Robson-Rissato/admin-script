                    fi
                fi
            done

            # Check drive health behind RAID card
            # Get the number of drives on the server
            drivecount=$(ssacli ctrl all show config detail | grep -A5 "Physical Drives$" | grep physicaldrive | wc -l);
            drivecount=$(($drivecount-1));
            # Loop through each drive
            for i in $(seq 0 $drivecount); do
                counter=$(($i+1));
                driveletter=$(ssacli ctrl all show config detail | grep -E "Disk Name" | awk '{print $3}' | cut -c 6- | sed -n "${counter}p");
                serial=$(smartctl -a -d cciss,$i /dev/sg1 | grep Serial | awk '{print $3}' | tail -c 4);
                if [ $(smartctl -a -d cciss,$i /dev/sg1 | grep -iE "Reallocate|Uncorrectable|Pending_Sector|Integrity Errors:" | awk '{print $NF}' | paste -sd+ | bc) -ne 0 ]; then
                    echo -e "Device: /dev/$driveletter\tStatus: ${red}FAILED${normal}\tSN: ${serial}"
                else
                    if [ $(smartctl -H -d cciss,$i /dev/sg1 | grep 'SMART overall-health self-assessment test' | awk '{print $6}') = PASSED ]; then
                        echo -e "Device: /dev/$driveletter\tStatus: ${green}PASSED${normal}\tSN: ${serial}"
                    fi
                fi
            done
        else
            for i in $(lsblk | grep disk | awk '{print $1}'); do
            serial=$(smartctl -i /dev/$i | grep Serial | awk '{print $3}' | tail -c 4);
                if [ $(smartctl -a /dev/$i | grep -iE "Reallocate|Uncorrectable|Pending_Sector|Integrity Errors:" | awk '{print $NF}' | paste -sd+ | bc) -ne 0 ]; then
                    echo -e "Device: /dev/$i\tStatus: ${red}FAILED${normal}\tSN: ${serial}"
                else
                    if [ $(smartctl -H /dev/$i | grep 'SMART overall-health self-assessment test' | awk '{print $6}') = PASSED ]; then
                    echo -e "Device: /dev/$i\tStatus: ${green}PASSED${normal}\tSN: ${serial}"
                    fi
                fi
            done
        fi
    else
        echo -e "\n\nError: hpssacli is not installed. Exiting"
        exit;
    fi

# If server does not have a RAID card, use smartctl to get drive health
else
    for i in $(lsblk -do NAME,RM,SIZE,RO,TYPE,MOUNTPOINT  | grep -v ' 1 ' | grep disk | awk '{print $1}'); do
    serial=$(smartctl -i /dev/$i | grep Serial | awk '{print $3}' | tail -c 4);
        if [ $(smartctl -a /dev/$i | grep -iE "Reallocate|Uncorrectable|Pending_Sector|Integrity Errors:" | awk '{print $NF}' | paste -sd+ | bc) -ne 0 ]; then
            echo -e "Device: /dev/$i\tStatus: ${red}FAILED${normal}\tSN: ${serial}"
        else
            if [ $(smartctl -H /dev/$i | grep 'SMART overall-health self-assessment test' | awk '{print $6}') = PASSED ]; then
            echo -e "Device: /dev/$i\tStatus: ${green}PASSED${normal}\tSN: ${serial}"
            fi
        fi
    done
fi
echo -e "\n"

# run dd disk speed
echo -e "\n${cyan}Running dd I/O benchmark test...${normal}"
printf "%-32s\n" "-" | sed 's/\s/-/g'
dd if=/dev/zero of=test1.img bs=1G count=1 oflag=dsync 2>&1 | awk '/bytes/{print "I/O Speed: \t\t"$(NF-1), $NF}' ; rm -f test1.img
echo -e "\n"


# run an fio test
echo -e "\n${cyan}Running fio sequential tests (1MB r/w)...${normal}"
printf "%-41s\n" "" | sed 's/ /-/g'

fio_read=$(fio --randrepeat=1 --ioengine=libaio --direct=1 --gtod_reduce=1 --name=read-test --filename=fio.test --bs=1M --iodepth=16 --size=4G --readwrite=read | grep -E "READ")
fio_write=$(fio --randrepeat=1 --ioengine=libaio --direct=1 --gtod_reduce=1 --name=write-test --filename=fio.test --bs=1M --iodepth=16 --size=4G --readwrite=write | grep -E "WRITE")

read=$(echo "$fio_read"  | awk '{print $3}' | sed 's/,//' | sed 's/)//' | sed 's/(//')
write=$(echo "$fio_write" | awk '{print $3}' | sed 's/,//' | sed 's/)//' | sed 's/(//')

echo -e "Read: \t\t\t"$read
echo -e "Write: \t\t\t"$write
echo -e "\n"


# run 7zip benchmark test
echo -e "\n${cyan}Running 7zip benchmark test...${normal}"
printf "%-30s\n" "-" | sed 's/\s/-/g'
if [ -x "$(command -v 7za)" ]; then
    command=7za
elif [ -x "$(command -v 7zr)" ]; then
    command=7zr
else
    command=7zip
fi
result=$($command b | tail -2)
compressing=$(echo "$result" | awk '{print $4}' | head -1)
decompressing=$(echo "$result" | awk '{print $8}' | head -1)
total=$(echo "$result" | awk '{print $4}' | tail -1)
printf "%-24s%s\n" "Compressing:" "${cyan}$compressing${normal}"
printf "%-24s%s\n" "Decompressing:" "${cyan}$decompressing${normal}"

# Calculate the difference between compressing and decompressing values
diff=$((decompressing - compressing))
percent_diff=$((100 * diff / decompressing))

if [ "$percent_diff" -gt 25 ]; then
  # Change the color of total value to green
  printf "%-24s%s\n" "Total:" "${yellow}$total${normal}"
else
  printf "%-24s%s\n" "Total:" "${green}$total${normal}"
fi

echo -e "\n"

# Adding delay and "CPU cooling down..." message
for i in $(seq 1 3); do
  printf "\r${cyan}CPU cooling down${normal}"
  for j in $(seq 1 $i); do
    printf "."
  done
  sleep 1
done
printf "\r%s" "                                   "

# Run final checklist
echo -e "\n${cyan}Running final checklist...${normal}"
printf "%-26s\n" "-" | sed 's/\s/-/g'
printf 'Hyperthreading: %-8s%s'; sed -e s/1/${green}ENABLED${normal}/ -e s/0/${red}DISABLED${normal}/ /sys/devices/system/cpu/smt/active
printf 'Virtualization: %-8s%s'; if [ ! -e /dev/kvm ]; then echo "${red}DISABLED${normal}"; else echo "${green}ENABLED${normal}"; fi
if [ "$(sensors | grep Package)" ]; then
    printf 'CPU temperature: %-7s%s'; sensors | grep Package | awk '{print $4}' | tr -d "+" | head -1 | cut -c1-2 | awk '{ if ($1 >= 75 && $1 < 94) printf ("%s%s%s\n", "'"$red"'", "'"HOT"'", "'"$normal"'"); else if ($1 > 93) printf ("%s%s%s\n","'"$red"'", "'"VERY HOT"'", "'"$normal"'"); else printf ("%s%s%s\n", "'"$green"'", "'"GOOD"'", "'"$normal"'"); }';
fi
if [ -x "$(command -v getenforce)" ]; then
printf 'SELinux: %-15s%s'; getenforce | sed -e s/Disabled/${red}DISABLED${normal}/ -e s/Enforcing/${green}ENFORCING${normal}/ -e s/Permissive/${yellow}PERMISSIVE${normal}/
fi
printf 'IPv6: %-18s%s'; sed -e s/0/${green}ENABLED${normal}/ -e s/1/${red}DISABLED${normal}/ /sys/module/ipv6/parameters/disable
if [ -x /bin/ping ]; then
    for site in "Cloudflare:1.1.1.1" "Google:8.8.8.8" "Level3:4.2.2.2" "Mirror:mirror.trouble-free.net"; do
        name=$(echo "$site" | cut -d: -f1)
        addr=$(echo "$site" | cut -d: -f2)
        if ping "$addr" -c 2 > /dev/null 2>&1; then
            status="${green}GOOD${normal}"
        else
            status="${red}oh nooooo${normal}"
        fi
        printf "%-23s %s\n" "${name} PING:" "$status"
    done
else
    echo 'Missing /bin/ping'
fi
echo -e "\n\n"

# install and run memtester. It is only supported on Ubuntu and Debian
if [[ "$(cat /etc/os-release | grep PRETTY_NAME |  grep -o '".*"' | sed 's/"//g')" =~ ^Ubuntu.* ]]; then
    if [ ! -x "$(command -v memtester)" ]; then
        apt update;
        apt -y install memtester > /dev/null 2>&1;
    else
        echo -e "${cyan}Running memtester quick test...${normal}"
        printf "%-31s\n" "-" | sed 's/\s/-/g'
        memtester 1G 1 | grep -A18 "Stuck Address"
