        elif [[ "$(cat /etc/os-release | grep PRETTY_NAME |  grep -o '".*"' | sed 's/"//g')" =~ ^Ubuntu.* ]]; then
            apt -y install bc iperf3 smartmontools memtester fio p7zip-full hdparm lshw lm-sensors curl > /dev/null 2>&1;
