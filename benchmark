#!/usr/bin/env bash

if [ "$COLORS" = "" ]; then
        blue=$(tput setaf 4)
        green=$(tput setaf 2)
        cyan=$(tput setaf 6)
        yellow=$(tput setaf 3)
        red=$(tput setaf 1)
        normal=$(tput sgr0)
fi

# Check options
if [ "$1" = "check" ] || [ "$1" = "checklist" ]; then
    # Run checklist
    echo -e "\n${cyan}Running final checklist...${normal}"
    printf "%-26s\n" "-" | sed 's/\s/-/g'
    printf 'Hyperthreading: %-8s%s'; sed -e s/1/${green}ENABLED${normal}/ -e s/0/${red}DISABLED${normal}/ /sys/devices/system/cpu/smt/active
    printf 'Virtualization: %-8s%s'; if [ ! -e /dev/kvm ]; then echo "${red}DISABLED${normal}"; else echo "${green}ENABLED${normal}"; fi
    if [ "$(sensors | grep Package)" ]; then
        printf 'CPU temperature: %-7s%s'; sensors | grep Package | awk '{print $4}' | tr -d "+" | head -1 | cut -c1-2 | awk '{ if ($1 >= 75 && $1 < 94) printf ("%s%s%s\n", "'"$red"'", "'"HOT"'", "'"$normal"'"); else if ($1 > 93) printf ("%s%s%s\n","'"$red"'", "'"VERY HOT"'", "'"$normal"'"); else printf ("%s%s%s\n", "'"$green"'", "'"GOOD"'", "'"$normal"'"); }';
    fi
    if [ -x "$(command -v getenforce)" ]; then
    printf 'SELinux: %-15s%s'; getenforce | sed -e s/Disabled/${red}DISABLED${normal}/ -e s/Enforcing/${green}ENFORCING${normal}/ -e s/Permissive/${yellow}PERMISSIVE${normal}/
    fi
    printf 'IPv6: %-18s%s'; sed -e s/0/${green}ENABLED${normal}/ -e s/1/${red}DISABLED${normal}/ /sys/module/ipv6/parameters/disable
    if [ -x /bin/ping ]; then
        for site in "Cloudflare:1.1.1.1" "Google:8.8.8.8" "Level3:4.2.2.2" "Mirror:mirror.trouble-free.net"; do
            name=$(echo "$site" | cut -d: -f1)
            addr=$(echo "$site" | cut -d: -f2)
            if ping "$addr" -c 2 > /dev/null 2>&1; then
                status="${green}GOOD${normal}"
            else
                status="${red}oh nooooo${normal}"
            fi
            printf "%-23s %s\n" "${name} PING:" "$status"
        done
    else
        echo 'Missing /bin/ping'
    fi
    echo -e "\n\n"
exit;
fi


if [ "$1" = "memory" ] || [ "$1" = "-m" ]; then
    # Get maximum capacity of the physical memory array
    max_capacity=$(dmidecode -t memory | grep -A5 "Physical Memory Array" | awk -F': ' '/Maximum Capacity/{print $2}' | head -1)

    # Get installed memory size
    memory_size=$(dmidecode -t 17 | grep -A5 "Memory Device$" | grep Size | grep -v "No Module Installed" | awk '{if ($3 ~ /MB/) print $2/1024; else print $2}' | awk '{sum+=$1} END {print (sum)}' | awk '{print int($0)}')

    # Get motherboard model
    motherboard_model=$(dmidecode -s baseboard-product-name | tail -1)

    # Calculate the length of the motherboard model
    motherboard_length=${#motherboard_model}

    # Calculate the length of the longest line
    header_line_length=$((motherboard_length + 23))
    max_capacity_line_length=$(( ${#max_capacity} + 24 ))
    memory_size_line_length=$(( ${#memory_size} + 24 ))
    longest_line_length=$(( header_line_length > max_capacity_line_length ? header_line_length : max_capacity_line_length ))
    longest_line_length=$(( longest_line_length > memory_size_line_length ? longest_line_length : memory_size_line_length ))
    line=$(printf '═%.0s' $(seq 1 "$longest_line_length"))

    # Print top border
    printf "╔%s╗\n" "$line"

    # Print motherboard model with cyan color and border
    printf "║ %-$(($longest_line_length-4))s ║\n" "${cyan}Motherboard Model:   $motherboard_model${normal}"

    # Print maximum capacity with yellow color and border
    printf "║ %-$(($longest_line_length+9))s ║\n" "${yellow}Maximum Capacity:    $max_capacity${normal} "

    # Print installed memory with yellow color and border
    printf "║ %-$(($longest_line_length+9))s ║\n" "${yellow}Installed Memory:    $memory_size GB${normal} "

    # Print middle border
    printf "╠%s╝\n" "$line"

    # Check if bank locator should be printed in the header
    bank_locator_check=$(dmidecode -t memory | grep 'Bank Locator' | awk '{print $3" "$4}' | head -1)
    if [[ $bank_locator_check != "Not Specified" ]]; then
        # Bank locator should be displayed in the header
        # Print header with cyan color and border
        printf "║ ${cyan}%-14s %-8s %-9s %-10s %-7s${normal}║\n" "Bank Locator" "Locator" "Size" "Type" "Speed"

        # Print separator line
        printf "╟─────────────────────────────────────────────────────╢\n"

        # Get unique Handles
        handles=$(dmidecode -t memory | grep -P "Handle\s+\w+" | awk '{print $2}')

        # Calculate CPU sockets
        cpu_sockets=$(lscpu | grep Socket | awk '{print $2}')

        # Skip handles based on CPU sockets
        if [ "$cpu_sockets" = "2" ]; then
            handles=$(echo "$handles" | awk 'NR>2')
        elif [ "$cpu_sockets" = "1" ]; then
            handles=$(echo "$handles" | awk 'NR>1')
        fi

        prev_processor=""
        # Loop over each unique Handle
        for handle in $handles; do
            # Extract section corresponding to this Handle
            section=$(dmidecode -t memory | grep -A20 -w "Handle $handle")

            # Extract details
            bank_locator=$(echo "$section" | grep 'Bank Locator' | awk -F': ' '{print $2}')
            locator=$(echo "$section" | awk -F': ' '/Locator:/{print $2}' | head -1)
            size=$(echo "$section" | grep 'Size' | awk -F': ' '{print $2}')
            type=$(echo "$section" | grep 'Type:' | awk -F': ' '{print $2}' | tail -n 1)
            speed=$(echo "$section" | grep 'Configured Memory Speed' | awk -F': ' '{print $2}' | awk '{print $1}')
            speed="${speed}MHz"

            # Check if module is installed and form the output
            if [[ $size == "No Module Installed" ]]; then
                size="Empty"
                type=""
                module_type="N/A"
                speed="N/A"
            else
                module_type=$(dmidecode -t memory | grep -A19 "Memory Device$" | grep "Type Detail:" | cut -d: -f2 | grep -E "Registered|LRDIMM" | head -1 | sed 's/^ *//' | sed 's/Synchronous Registered (Buffered)/RDIMM/' | sed 's/Registered (Buffered)/RDIMM/' | sed 's/Synchronous LRDIMM/LRDIMM/')
                type="${type} "
            fi

            # Extract the processor number from the Bank Locator
            processor=$(echo "$bank_locator" | awk '{print $1}')

            # Check if the current handle belongs to a different processor
            if [[ $prev_processor != "" && $prev_processor != "$processor" ]]; then
                # Print a separator line between processors
                printf "║\n"
                printf "╟─────────────────────────────────────────────────────╢\n"
                printf "║\n"
            fi

            # Print the output with formatting and green color
            printf "║ ${green}%-14s %-8s %-9s %-10s %-7s${normal}║\n" "${bank_locator}" "${locator}" "${size}" "${type}${module_type}" "${speed}"

            prev_processor="$processor"
        done
    else
        # Bank locator should not be displayed in the header
        printf "║ ${cyan}%-18s %-7s %-15s %-9s${normal}║\n" "Locator" "Size" "Type" "Speed"

        # Print separator line
        printf "╟─────────────────────────────────────────────────────╢\n"

        # Get unique Handles
        handles=$(dmidecode -t memory | grep -P "Handle\s+\w+" | awk '{print $2}')

        # Calculate CPU sockets
        cpu_sockets=$(lscpu | grep Socket | awk '{print $2}')

        # Skip handles based on CPU sockets
        if [ "$cpu_sockets" = "2" ]; then
            handles=$(echo "$handles" | awk 'NR>2')
        elif [ "$cpu_sockets" = "1" ]; then
            handles=$(echo "$handles" | awk 'NR>1')
        fi

        prev_processor=""
        # Loop over each unique Handle
        for handle in $handles; do
            # Extract section corresponding to this Handle
            section=$(dmidecode -t memory | grep -A20 -w "Handle $handle")

            # Extract details
            locator=$(echo "$section" | awk -F': ' '/Locator:/{print $2}' | head -1)
            size=$(echo "$section" | grep 'Size' | awk -F': ' '{print $2}')
            type=$(echo "$section" | grep 'Type:' | awk -F': ' '{print $2}' | tail -n 1)
            speed=$(echo "$section" | grep 'Configured Memory Speed' | awk -F': ' '{print $2}' | awk '{print $1}')
            speed="${speed}MHz"

            # Check if module is installed and form the output
            if [[ $size == "No Module Installed" ]]; then
                size="Empty"
                type=""
                module_type="N/A"
                speed="N/A"
            else
                module_type=$(dmidecode -t memory | grep -A19 "Memory Device$" | grep "Type Detail:" | cut -d: -f2 | grep -E "Registered|LRDIMM" | head -1 | sed 's/^ *//' | sed 's/Synchronous Registered (Buffered)/RDIMM/' | sed 's/Registered (Buffered)/RDIMM/' | sed 's/Synchronous LRDIMM/LRDIMM/')
                type="${type} "
            fi

            # Extract the processor number from the Locator
            processor=$(echo "$locator" | awk '{print $2}')

            # Check if the current handle belongs to a different processor
            if [[ $prev_processor != "" && $prev_processor != "$processor" ]]; then
                # Print a separator line between processors
                printf "║\n"
                printf "╟─────────────────────────────────────────────────────╢\n"
                printf "║\n"
            fi

            # Print the output with formatting and green color
            printf "║ ${green}%-17s %-8s %-15s %-9s${normal}║\n" "${locator}" "${size}" "${type}${module_type}" "${speed}"

            prev_processor="$processor"
        done
    fi

    # Print bottom border
    printf "╚═════════════════════════════════════════════════════╝\n"
    exit;
fi


if [ "$1" = "disk" ] || [ "$1" = "-d" ]; then

        # Check to see if the required packages are installed.
        # Install packages based on operating system
        if [[ "$(cat /etc/os-release | grep PRETTY_NAME |  grep -o '".*"' | sed 's/"//g')" =~ ^CentOS.* ]]; then
            yum -y install bc iperf3 smartmontools fio p7zip hdparm lshw lm_sensors curl > /dev/null 2>&1;
        elif [[ "$(cat /etc/os-release | grep PRETTY_NAME |  grep -o '".*"' | sed 's/"//g')" =~ ^Stream.* ]]; then
            yum -y install bc iperf3 smartmontools fio hdparm lshw lm_sensors curl > /dev/null 2>&1;
            dnf -y install epel-release > /dev/null 2>&1;
            dnf -y install p7zip p7zip-plugins > /dev/null 2>&1;
