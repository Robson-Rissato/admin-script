function grepfiles() {

        if [ "$1" = "" ]; then
                MYPATH=`pwd`;
        else

                MYPATH=$1;
        fi


        verifypath ${MYPATH}

	#wget -N http://mirror.trouble-free.net/exclude.txt && find | grep -v -f exclude.txt  | grep .php
	if [ "$sudo" = "1" ]; then
                getrunas ${MYPATH}
        fi

	echo "Moving into ${MYPATH}";
        cd ${MYPATH}
	verifywpconfig

	if [ "$sudo" = "1" ]; then
		${SUDOPATH} -u $runas ${WGETPATH} -N http://mirror.trouble-free.net/exclude.txt && ${SUDOPATH} -u $runas ${FINDPATH} | ${GREPPATH} -v -f exclude.txt  | ${GREPPATH} .php
	else
		${WGETPATH} -N http://mirror.trouble-free.net/exclude.txt && ${FINDPATH} | ${GREPPATH} -v -f exclude.txt  | ${GREPPATH} .php
	fi
}

function update() {

        if [ "$1" = "" ]; then
                MYPATH=`pwd`;
        else

                MYPATH=$1;
        fi


	verifypath ${MYPATH}
	if [ "$sudo" = "1" ]; then
		getrunas ${MYPATH}
	fi

	echo "Moving into ${MYPATH}";
	cd ${MYPATH}
	verifywpconfig

	echo
	echo -n "${cyan}Continue with force wordpress update? ${normal} ";
	read wait;
	echo
	if [ ! "$wait" = "y" ]; then
		echo "Exiting";
		exit;
	fi
 
	if [ "$sudo" = "1" ]; then
 		echo "Will update wordpress to the latest version in dir ${MYPATH}";
		${SUDOPATH} -u $runas ${WGETPATH} -q http://wordpress.org/latest.tar.gz -O - | ${SUDOPATH} -u $runas ${TARPATH} --strip-components=1 -zxv
		echo "Done";
	else
		${WGETPATH} -q http://wordpress.org/latest.tar.gz -O - | ${TARPATH} --strip-components=1 -zxv
	fi
}

