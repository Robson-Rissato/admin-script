function runabackup() {

	if [ "$1" = "" ]; then
		MYPATH=`pwd`;
	else

	        MYPATH=$1;
	fi
        verifypath ${MYPATH}

        echo "Moving into ${MYPATH}";
        cd ${MYPATH}


        verifywpconfig

        if [ "$sudo" = "1" ]; then
		echo "backup functions call swift and run as root";
        fi

	# get mysqldump
	getmysqlfromwpconfig

	if [ -e ${MYSQLDB}.backup.sql ]; then
		echo "Mysqldump file ${MYSQLDB}.backup.sql already exists at line $LINENO";
		exit;
	fi

	 ${MYSQLDUMPPATH} -u ${MYSQLUSER} ${MYSQLDB} --password=${MYSQLPASS} > ${MYSQLDB}.backup.sql
         ${CHMODPATH} 600 ${MYSQLDB}.backup.sql

	if [ "$sudo" = "1" ]; then
		getrunas ${MYPATH}
		${CHOWNPATH} $runas:$runas ${MYSQLDB}.backup.sql
	fi

	backupfolder ${MYPATH} ${MYSQLDB}
}

function backupfolder() {
        #get date
        year=$(date +%Y)
        month=$(date +%m)
        day=$(date +%d)

	if [ "$1" = "" ]; then
		echo "got blank folder at line $LINENO in function backup folder";
	fi

	if [ "$2" = "" ]; then
		echo "Got blank mysqluser at line $LINENO in function backup folder - this is used for naming only";
	fi
	if [ -e /root/.swift/hostname ]; then
		CONTAINER=`cat /root/.swift/hostname`;
	else
		CONTAINER=`hostname`;
	fi

	/admin/swift/fly ${CONTAINER} ${MYPATH} frombackup ${MYSQLDB}-${year}-${month}-${day}
}

function wpupdateplugins() {
 
       if [ "$1" = "" ]; then
                MYPATH=`pwd`;
        else

                MYPATH=$1;
        fi

        verifypath ${MYPATH}

        echo "Moving into ${MYPATH}";
        cd ${MYPATH}


        verifywpconfig

	if [ "$sudo" = "1" ]; then
		getrunas ${MYPATH}
        fi


	if [ ! -d wp-content/plugins ]; then
		echo 'Did not find folder wp-content/plugins at line $LINENO';
		exit;
	fi
	echo "Moving into plugin dir ";
	cd wp-content/plugins

	for wpplugdir in `${FINDPATH} . ! -path . -maxdepth 1 -type d | cut -d/ -f2`; do
		echo "Working on plugin ${wpplugdir}";
		getwpplugindownloadlink ${wpplugdir}
		if [ ! "$PLUGINDLURL" = "" ]; then
			if [ -e $PLUGFILE ]; then
				echo "$PLUGFILE exists, can not continue";
				return;
			fi
			if [ "$sudo" = "1" ]; then
				${SUDOPATH} -u $runas $WGETPATH ${PLUGINDLURL}
				${SUDOPATH} -u $runas $UNZIPPATH -o ${PLUGFILE}
				${SUDOPATH} -u $runas $RMPATH ${PLUGFILE}

			else
				$WGETPATH ${PLUGINDLURL}
                        	$UNZIPPATH -o ${PLUGFILE}
                        	$RMPATH ${PLUGFILE}
			fi
			echo "Updated plugin";
			echo
		fi
	done


}

function runscan() {

        if [ "$1" = "" ]; then
                MYPATH=`pwd`;
	elif [ "$1" = "skip" ]; then
		MYPATH=$1;
        else

                MYPATH=$1;
        fi

	if [ "$1" = "skip" ]; then
		echo 'Skipping verify path check';
	else
        	verifypath ${MYPATH}

        	echo "Moving into ${MYPATH}";
        	cd ${MYPATH}
	fi

	if [ "$1" = "skip" ]; then
		echo 'Skipping wp-config.php check';
	else
        	verifywpconfig
	fi

        if [ -f scan.txt ]; then
                echo "scan.txt file found, remove first";
                exit;
        fi

	/admin/clamscan shelldb > scan.txt	


}


