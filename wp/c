# functions
function verifypath() {

	if [ "$1" = "" ]; then
		echo "Error: verifypath lookup was blank at line $LINENO";
		exit;
	fi

	if [ -f $1/wp-config.php ]; then
		echo "Found $1/wp-config.php";
	else
		echo "$1/wp-config.php does not exist at line $LINENO";
		exit;
	fi
}

function getrunas() {
	if [ "$1" = "" ]; then
                echo "Error: getrunas lookup was blank at line $LINENO";
                exit;
        fi

	if [ -f $1/wp-config.php ]; then
		runas=`${LSPATH} -ld ${1}/wp-config.php | awk '{print $3}'`;
		if [ "$runas" = "root" ]; then
			echo "Error: Found ownership as user root for $1/wp-config.php at line $LINENO";	
			exit;
		elif [ "$runas" = "" ]; then
			echo "Error: username came back blank at line $LINENO";
			exit;
		else
			echo "Found user $runas";
		fi
	else
                echo "$1/wp-config.php does not exist at line $LINENO";
                exit;
        fi

}

function verifywpconfig() {

        if [ ! -f wp-config.php ]; then
                echo "wp-config.php is not found in this directory, exiting at line $LINENO";
                exit;
        fi

}

function getwpplugindownloadlink() {

	if [ "$1" = "" ]; then
		echo 'no plugin passed in getwpplugindownloadlink at line $LINENO';
		exit;
	fi
	PLUGINSEARCH=$1;
	#echo "trying ${CURLPATH} -s https://${WPAPI}/plugins/info/1.0/${PLUGINSEARCH}.json and ${PYTHONPATH} -mjson.tool";
	PLUGINDLURL=`${CURLPATH} -s "https://${WPAPI}/plugins/info/1.0/${PLUGINSEARCH}.json" | ${PYTHONPATH} -mjson.tool | ${GREPPATH} download_link  | ${GREPPATH}  ${WPDOWNLOADS} | cut -d: -f2- | cut -d\" -f2`;
	#PLUGINDLURL=`${CURLPATH} -s "https://${WPAPI}/plugins/info/1.0/${PLUGINSEARCH}.json" | ${PYTHONPATH} -mjson.tool`;
	if [ "${PLUGINDLURL}" = "" ]; then
		echo "${PLUGINSEARCH} returned no wordpress plugin download url";
		echo
		return;
	else
		PLUGFILE=`echo $PLUGINDLURL | cut -d/ -f5`;
		echo "Returned $PLUGINDLURL and file $PLUGFILE";
		echo
	fi
}

getmysqlfromwpconfig() {
	if [ ! -f wp-config.php ]; then
		echo 'Error: Did not find wp-config.php at line $LINENO in function getmysqlfromwpconfig';
		exit;
	fi

	# returns all three cat wp-config.php | grep define\(\'DB_ | egrep "DB_NAME|DB_USER|DB_PASS" | cut -d\' -f
	ARRAY=(`cat wp-config.php | grep define\(\'DB_ | egrep "DB_NAME|DB_USER|DB_PASS" | cut -d\' -f4`);
	if [ "${ARRAY[0]}" = "" ]; then
		echo "Returned blank mysql username at line $LINENO";
		exit;
	else
		MYSQLUSER=${ARRAY[0]};

	fi

	if [ "${ARRAY[1]}" = "" ]; then
		echo "Returned blank mysql db at line $LINENO";
		exit;
        else
                MYSQLDB=${ARRAY[1]};

        fi

	if [ "${ARRAY[2]}" = "" ]; then
		echo "Returned blank mysql password at line $LINENO";
		exit;
        else
                MYSQLPASS=${ARRAY[2]};

        fi
}

