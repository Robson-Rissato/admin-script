#!/usr/bin/env bash

# modified 07/21/2025
# this runs daily and is will be used like the upate litespeed script on cpanel servers
# oh we should run update litespeed on da

# /admin/storage/fixquota skip will skip quota
# /admin/storage/fixquota fast will skip quota and rewrite_confs
# /admin/mccleanqueue runs on da and cpanel systems hourly some killall commands are there
# change to stable branch in da
# disable antibot mode on directadmin causing login issues - 12/12/2024
# disable login_keys_notify_on_creation reported as spam sometimes
# disable dynamic motd
# disable resource limit notifications that clients get annoyed at for cloudlinux
# enable lost password
# fix quotas on rhel systems if trying to use the zfs method
# update custom dovecot compile if it exists

if [ ! -d /usr/local/directadmin/data/users ]; then
        echo 'Requires directadmin';
        exit;
fi

if [ ! -x /usr/sbin/zfs ]; then
        echo 'Missing /usr/sbin/zfs skipping zfs functions';
fi

maxload='30';

# this only needs to run once
# added 4/12/2025
if [ -x /usr/bin/replace ]; then
	if [ -f /usr/local/directadmin/plugins/softaculous/images/universal.php ]; then
		replace centos.is.cc `hostname` -- /usr/local/directadmin/plugins/softaculous/images/universal.php
	fi
fi
function set_quota() {
	myuser=$1;
	#echo $myuser;
	if [ -f /usr/local/directadmin/data/users/$myuser/user.conf ]; then
                # quota is in mb
		if [ "$myuser" = "admin" ]; then
			echo '.admin user getting set to unlimited';
			zfs set quota=none vz/admin
			zfs set refquota=none vz/admin
			zfs set userquota@admin=none vz/admin
		else
                	myquota=`grep ^quota /usr/local/directadmin/data/users/$myuser/user.conf | cut -d= -f2`;
                	# test we are a number
                	if [[ $myquota =~ ^[0-9]+$ ]] ; then
                        	echo "..Setting user $myuser to quota $myquota in MB ";
				# quota includes snapshots
                        	zfs set quota=none vz/${myuser}
				zfs set refquota=${myquota}M vz/${myuser}
                        	zfs set userquota@${myuser}=${myquota}M vz/${myuser}
			else
				echo '...We do not have any quota set on the account setting 1TB';
				zfs set quota=none vz/${myuser}
				zfs set refquota=1T vz/${myuser}
                        	zfs set userquota@${myuser}=1T vz/${myuser}
                	fi
		fi
        fi



}

## 
## BEGIN
## 

##
## Create initial directories if they don't exist
##

for dir_needed in /usr/local/directadmin/data/templates/custom /backup; do
	if [ ! -d ${dir_needed} ]; then
		mkdir -p ${dir_needed}
	fi
done


##
## set quota defaults
##
if [ "$1" = "" ]; then
		if [ -x /usr/sbin/zfs ]; then
                	for user in `ls /usr/local/directadmin/data/users | egrep -v "admin|quags"`; do
                       		echo -n 'working on';
                        	echo -n " $user.";
                        	curload=`awk '{print $1}' /proc/loadavg  | cut -d. -f1`;
                        	if [ "$curload" -lt "$maxload" ]; then
                               		echo -n ".load ok.";
                               		set_quota $user
                        	else
                                	echo "Break from setting quotas due to load of $curload";
                        	fi
                	done
		fi
elif [ "$1" = "skip" -o $1 = "fast" ]; then
	echo ' Skipping quota for fast run';
else
	set_quota $1
	exit 0;
fi

echo

##
## set jailshell
## skip on cloudlinux
##

if [ -e /bin/cagefs.server ]; then
	echo 'Skipping jailshell/bubblewrap/cgroups for cloudlinux systems';
	/usr/local/directadmin/directadmin set jail 0
else
	if [ "$1" = "skip" -o "$1" = "fast" ]; then
		echo ' Skipping jailshell for fast run';
	else
		echo 'Setting jailshell';
		for i in `ls /usr/local/directadmin/data/users | egrep -v "admin|quags"`; do chsh -s /usr/bin/jailshell $i; done
	fi

	# cgroups for storage
	if [ ! -e /usr/sbin/unitd ]; then
	        # install cgroups config
        	/admin/storage/buildcgroup
	fi
fi


# zfs quotas
if [ -x /usr/sbin/zfs ]; then

	# detain needs this for zpool list
	if [ ! -d /usr/local/directadmin/bin ]; then
        	mkdir -p /usr/local/directadmin/bin
	fi


	# update quota if needed
	cd /usr/local/directadmin/bin
	/bin/cp -u -v /admin/storage/quota /usr/local/directadmin/bin/quota && chown root:root /usr/local/directadmin/bin/quota
	/bin/cp -u -v /admin/storage/repquota /usr/local/directadmin/bin/repquota && chown root:root /usr/local/directadmin/bin/repquota

	if [ ! -f /usr/local/directadmin/bin/setquota ]; then
		echo 'Missing /usr/local/directadmin/bin/setquota adding it in';
		cp /admin/storage/setquota /usr/local/directadmin/bin/setquota
		chown root:root /usr/local/directadmin/bin/setquota
		/usr/local/directadmin/directadmin set setquota /usr/local/directadmin/bin/setquota restart
	else
		/bin/cp -u -v /admin/storage/setquota /usr/local/directadmin/bin/setquota && chown root:root /usr/local/directadmin/bin/setquota
	fi
fi

##
## rspamd fix on new account if rspamd is installed
##
if [ -e /usr/bin/rspamd ]; then
	if [ -e /admin/storage/domain_create_post.sh ]; then
		if [ ! -e /usr/local/directadmin/scripts/custom/domain_create_post.sh ]; then
			cp /admin/storage/domain_create_post.sh /usr/local/directadmin/scripts/custom/domain_create_post.sh
			chown diradmin:diradmin /usr/local/directadmin/scripts/custom/domain_create_post.sh
		else
			cp -u -v  /admin/storage/domain_create_post.sh /usr/local/directadmin/scripts/custom/domain_create_post.sh
			chmod 755 /usr/local/directadmin/scripts/custom/domain_create_post.sh
		fi
	fi
fi

if [ -f /admin/storage/domain_create_pre.sh ]; then
	if [ ! -e /usr/local/directadmin/scripts/custom/domain_create_pre.sh ]; then
		cp /admin/storage/domain_create_pre.sh /usr/local/directadmin/scripts/custom/domain_create_pre.sh
		chown diradmin:diradmin /usr/local/directadmin/scripts/custom/domain_create_pre.sh
		echo 'Added domain_create_pre.sh to block cf and freenom domains';
		echo
	else
		cp -u -v /admin/storage/domain_create_pre.sh /usr/local/directadmin/scripts/custom/domain_create_pre.sh
	fi
fi

#blocked domains
if [ -f /admin/ml/commondomains ]; then
	if [ ! -f /usr/local/directadmin/scripts/custom/commondomains ]; then
		cp /admin/ml/commondomains /usr/local/directadmin/scripts/custom/commondomains
		chown diradmin:diradmin /usr/local/directadmin/scripts/custom/commondomains
		echo "Added /usr/local/directadmin/scripts/custom/commondomains";
	else
		cp -u -v /admin/ml/commondomains /usr/local/directadmin/scripts/custom/commondomains
	fi
fi

# dovecot config if in use
if [ -f /usr/local/directadmin/custombuild/custom/dovecot/configure.dovecot ]; then
	if [ -f /admin/storage/config/dovecot/configure.dovecot ]; then
		cp -u -v /admin/storage/config/dovecot/configure.dovecot /usr/local/directadmin/custombuild/custom/dovecot/configure.dovecot
		chown diradmin:diradmin /usr/local/directadmin/custombuild/custom/dovecot/configure.dovecot
		chmod +x /usr/local/directadmin/custombuild/custom/dovecot/configure.dovecot
	else
		echo 'NOTE: /usr/local/directadmin/custombuild/custom/dovecot/configure.dovecot exists but there is no /admin/storage/config/dovecot/configure.dovecot if we do not have a custom config of dovecot to track remove the custombuild override';
		sleep 5;
	fi
fi
##
## forbidden domains list
##
/bin/cp -u -v /admin/storage/config/forbidden_domains.list /usr/local/directadmin/data/templates/custom/forbidden_domains.list


# zfs create
if [ -x /usr/sbin/zfs ]; then
	cp -u -v /admin/storage/user_create_post.sh /usr/local/directadmin/scripts/custom/user_create_post.sh   
	chmod 700 /usr/local/directadmin/scripts/custom/user_create_post.sh 

	# zfs delete
	cp -u -v /admin/storage/user_destroy_pre.sh /usr/local/directadmin/scripts/custom/user_destroy_pre.sh
	chmod 700 /usr/local/directadmin/scripts/custom/user_destroy_pre.sh
else
	echo 'No zfs detected skipping user create and user destroy post';
fi

# protect admin login by ips
cp -u -v /admin/storage/session_create_pre.sh /usr/local/directadmin/scripts/custom/session_create_pre.sh
chmod 700 /usr/local/directadmin/scripts/custom/session_create_pre.sh
chown diradmin:diradmin /usr/local/directadmin/scripts/custom/session_create_pre.sh

if [ -f /usr/local/directadmin/scripts/custom/all_pre.sh ]; then
	echo 'Removing /usr/local/directadmin/scripts/custom/all_pre.sh as it has been replaced with session_create_pre.sh';
	/bin/rm -v /usr/local/directadmin/scripts/custom/all_pre.sh
fi

#limit user backup by load
cp -u -v /admin/storage/user_backup_pre.sh /usr/local/directadmin/scripts/custom/user_backup_pre.sh
chmod 755 /usr/local/directadmin/scripts/custom/user_backup_pre.sh
chown diradmin:diradmin /usr/local/directadmin/scripts/custom/user_backup_pre.sh

# restart ssh
cp -u -v /admin/storage/user_activate_post.sh /usr/local/directadmin/scripts/custom/user_activate_post.sh
chmod 755 /usr/local/directadmin/scripts/custom/user_activate_post.sh
chown diradmin:diradmin /usr/local/directadmin/scripts/custom/user_activate_post.sh

# fix login keys
if [ -d /usr/local/directadmin/data/users ]; then
	cd /usr/local/directadmin/data/users
	for i in *; do if [ -f $i/user.conf ]; then /admin/replace-linux login_keys=OFF login_keys=ON -- $i/user.conf; fi; done
fi

# directadmin packages for storage, propack and non propack
echo 'Package checks';
if [ -d /usr/local/directadmin/data/users/admin/packages ]; then
	# unitd being used to detect propack
	if [ ! -e /usr/sbin/unitd ]; then
		echo 'Propack not detected';
		if [ -d /admin/storage/packages/ ]; then
			if [ ! -e /usr/local/directadmin/data/users/admin/packages/st100.pkg ]; then
				echo 'Updating standard packages ';
				rsync -v -a --exclude packages.list /admin/storage/packages/ /usr/local/directadmin/data/users/admin/packages/
			fi

			# check if file is empty
			if [ ! -s /usr/local/directadmin/data/users/admin/packages.list ]; then
				/bin/cp -f /admin/storage/packages/packages.list /usr/local/directadmin/data/users/admin/packages.list
			else
	                	/bin/cp -u -f /admin/storage/packages/packages.list /usr/local/directadmin/data/users/admin/packages.list
			fi

			chown diradmin:diradmin -R /usr/local/directadmin/data/users/admin/packages/
			chown diradmin:diradmin /usr/local/directadmin/data/users/admin/packages.list
			# reseller is separate
			if [ -d /usr/local/directadmin/data/admin/packages ]; then
				if [ -d /admin/storage/reseller/packages ]; then
					if [ ! -e /usr/local/directadmin/data/admin/packages/RSONE.pkg ]; then
                				echo 'Updating standard reseller packages';
                				rsync -v -a /admin/storage/reseller/packages/ /usr/local/directadmin/data/admin/packages/
					fi

					if [ ! -s /usr/local/directadmin/data/admin/packages.list ]; then
						/bin/cp -f /admin/storage/reseller/packages.list /usr/local/directadmin/data/admin/packages.list
					else
	                			/bin/cp -u -f /admin/storage/reseller/packages.list /usr/local/directadmin/data/admin/packages.list
					fi
        			fi
				chown diradmin:diradmin -R /usr/local/directadmin/data/admin/packages/
				chown diradmin:diradmin /usr/local/directadmin/data/admin/packages.list
			fi
		fi
	# this is propack stuff
	else
		echo 'Detected propack';
		if [ -d /admin/storage/propack/packages ]; then
			if [ ! -e /usr/local/directadmin/data/users/admin/packages/Standard.pkg ]; then
				echo 'Updating Propack packages';
				rsync -v -a /admin/storage/propack/packages/ /usr/local/directadmin/data/users/admin/packages/
			fi
			if [ ! -s /usr/local/directadmin/data/users/admin/packages.list ]; then
				/bin/cp -f /admin/storage/propack/packages.list /usr/local/directadmin/data/users/admin/packages.list
			else
	                	/bin/cp -u -f /admin/storage/propack/packages.list /usr/local/directadmin/data/users/admin/packages.list
			fi
		fi

		if [ -d /admin/storage/propack/reseller ]; then
			if [ -d /usr/local/directadmin/data/admin/packages ]; then
				if [ ! -e /usr/local/directadmin/data/admin/packages//RSONE.pkg ]; then
					echo 'Updating propack reseller packages';
					rsync -v -a /admin/storage/propack/reseller/packages/ /usr/local/directadmin/data/admin/packages/
				fi
				if [ ! -s /usr/local/directadmin/data/admin/packages.list ]; then
	                                /bin/cp -f /admin/storage/propack/reseller/packages.list /usr/local/directadmin/data/admin/packages.list
				else
					/bin/cp -u -f /admin/storage/propack/reseller/packages.list /usr/local/directadmin/data/admin/packages.list
				fi
			fi
		fi

		if [ -d /usr/local/directadmin/data/users/admin/packages/ ]; then
			chown diradmin:diradmin -R /usr/local/directadmin/data/users/admin/packages/
		fi

		if [ -f /usr/local/directadmin/data/users/admin/packages.list ]; then
			chown diradmin:diradmin /usr/local/directadmin/data/users/admin/packages.list
			chmod 600 /usr/local/directadmin/data/users/admin/packages.list
		fi

		# set permissions
		if [ -d /usr/local/directadmin/data/admin/packages/ ]; then
			chown diradmin:diradmin -R /usr/local/directadmin/data/admin/packages/
		fi

		if [ -f /usr/local/directadmin/data/admin/packages.list ]; then
			chown diradmin:diradmin /usr/local/directadmin/data/admin/packages.list
                	chmod 600 /usr/local/directadmin/data/admin/packages.list
		fi
	fi
fi

echo

# ip whitelist
#if [ -f /admin/storage/ip_whitelist ]; then
#	echo 'Updating ip whitelist ';
#	if [ ! -s /usr/local/directadmin/data/admin/ip_whitelist ]; then
#		cp -f /admin/storage/ip_whitelist /usr/local/directadmin/data/admin/ip_whitelist
#	else
#		cp -u -f /admin/storage/ip_whitelist /usr/local/directadmin/data/admin/ip_whitelist
#	fi
#fi

# ips to whitelist instead of having a running list
if [ -f /usr/local/directadmin/data/admin/ip_whitelist ]; then
	for whitelistip in 127.0.0.1 216.158.226.14 192.64.80.218 192.64.80.219 192.64.80.220 192.64.80.221 192.64.80.222; do
		wlcheck=`grep ^${whitelistip} /usr/local/directadmin/data/admin/ip_whitelist | tail -n 1`;
		if [ "$wlcheck" = "" ]; then
			echo ${whitelistip} >> /usr/local/directadmin/data/admin/ip_whitelist
			echo "addiing ${whitelistip} to /usr/local/directadmin/data/admin/ip_whitelist";
		fi
	done
fi

echo

# update litespeed
if [ "$1" = "fast" ]; then
	echo 'Skipping update litespeed and tmpreaper on fast';
else
	shorthostname=`hostname -s | cut -c1-7`;
	if [ "$shorthostname" = "storage" ]; then
		echo 'Skipping litespeed updates on storage systems';
	else
		# we are not updating litespeed here because custombuild is handling it
		if [ -f /usr/local/lsws/conf/httpd_config.xml ]; then
			if [ ! "$1" = "fast" ]; then
				cp -u -f /admin/storage/config/httpd_config.xml /usr/local/lsws/conf/httpd_config.xml && chmod 600 /usr/local/lsws/conf/httpd_config.xml && chown lsadm:lsadm /usr/local/lsws/conf/httpd_config.xml && echo 'updated /usr/local/lsws/conf/httpd_config.xml' && /admin/res httpd && echo 'updated litespeed xml'
			fi
			if [ ! -f /usr/local/directadmin/data/templates/custom/cust_httpd.CUSTOM.2.pre ]; then
        			mkdir -p /usr/local/directadmin/data/templates/custom/
        			cat > /usr/local/directadmin/data/templates/custom/cust_httpd.CUSTOM.2.pre <<EOF
<IfModule Litespeed>
  CacheRoot lscache
</IfModule>
EOF
			        /admin/res httpd
  		      		echo 'Updated litespeed config cust_httpd.CUSTOM.2.pre';

			fi
			if [ -d /usr/local/lsws/logs ]; then
				if [ -x /usr/sbin/tmpreaper ]; then
					tmpreaper --verbose 100h /usr/local/lsws/logs
				fi
			fi
		else
			echo 'Litespeed not found but we are not storage?';
		fi
	fi
fi

echo

# zfs additions
if [ -x /usr/sbin/zfs ]; then
	if [ -f /usr/local/directadmin/scripts/custom/user_destroy_post.sh ]; then
		mv /usr/local/directadmin/scripts/custom/user_destroy_post.sh /usr/local/directadmin/scripts/custom/user_destroy_pre.sh
	fi
fi

# remove lsws logs that are not needed
if [ -d /usr/local/lsws/logs ]; then
	cd /usr/local/lsws/logs
	year=`date +%Y`;
	/bin/rm -v /usr/local/lsws/logs/*.${year}_*
fi

echo

if [ -f /root/.bash_profile -o -f /root/.bashrc ]; then
        if [ -f /root/.bash_profile ]; then
                thefile=/root/.bash_profile;
        elif [ -f /root/.bashrc ]; then
                thefile=/root/.bashrc;
        else
                echo 'Error in histtimeformat: How did I get there';
                exit;
        fi

        hcheck=`grep HISTTIMEFORMAT ${thefile}`;
        if [ "$hcheck" = "" ]; then
                echo 'Adding histtimeformat';
                echo 'export HISTTIMEFORMAT="%m/%d/%y %T "' >> ${thefile}
        else
                echo 'Histtimeformat is done';
        fi
fi

echo

# settings

#https://cloudlinux.zendesk.com/hc/en-us/articles/4414825874706-How-to-enable-or-disable-Imunify360-anti-bot-protection
#imunify360-agent config update '{"WEBSHIELD": {"splash_screen": true}}' - this enables
#imunify360-agent config update '{"WEBSHIELD": {"splash_screen": false}}' - this disables
if [ -x /usr/bin/imunify360-agent ]; then
	imunify360-agent config update '{"WEBSHIELD": {"splash_screen": false}}'
fi

# no need to high load messages in directadmin message system since we don't use it
/usr/local/directadmin/directadmin set check_load 0

# joe uses this
if [ -x /usr/sbin/zfs ]; then
	if [ ! -e /usr/local/bin/zpoollist ]; then
		/bin/cp /admin/storage/zpoollist /usr/local/bin/zpoollist
	else
		/bin/cp -u /admin/storage/zpoollist /usr/local/bin/zpoollist
	fi
fi

# fix for jetbackup mysqldump
if [ -d /usr/local/jetapps ]; then
	# tt 63254 127.0.0.1 is no longer valid
	for myfile in my.cnf mysql.conf; do
			if [ -f /usr/local/directadmin/conf/$myfile ]; then
			jbcheck=`grep ^host=127.0.0.1$ /usr/local/directadmin/conf/$myfile`;
			if [ "$jbcheck" = "host=127.0.0.1" ]; then
				#echo "host=127.0.0.1" >> /usr/local/directadmin/conf/$myfile
				/admin/replace-linux 127.0.0.1 localhost -- /usr/local/directadmin/conf/$myfile
				echo "added host fix in $myfile";
			fi
		fi
	done
	# breaks bwrap now so we skip it on debian
	# fix for Error: mysqldump: Got error: 2002: Can't connect to local MySQL server through socket '/tmp/mysql.sock' (2) when trying to connect
	# tested manually in snapshot and works
	# does not appear to affect jailshell
	if [ -f /etc/redhat-release ]; then
		if [ ! -e /tmp/mysql.sock ]; then
			if [ -e /usr/local/mysql/data/mysql.sock ]; then
				ln -s /usr/local/mysql/data/mysql.sock /tmp/mysql.sock
			fi
		fi
	fi
fi

echo

# fix for softaculous
if [ -f /usr/local/directadmin/plugins/softaculous/bin/soft ]; then
	chmod 4555 /usr/local/directadmin/plugins/softaculous/bin/soft
fi
#https://docs.directadmin.com/directadmin/general-usage/disk-usage-bandwidth.html#how-is-disk-space-usage-calculated
# new default 2 does not allow repquota wrapper to be used
if [ -x /usr/sbin/zfs ]; then
	/usr/local/directadmin/directadmin set realtime_quota 0
fi

# clean /tmp
# clear old /tmp
if [ "$1" = "fast" ]; then
	echo 'Skipping tmpreaper on fast';
else
	if [ -x /usr/sbin/tmpreaper ]; then
		if [ ! -f /admin/configs/_skiptmpclear ]; then
       			if [ -d /tmp ]; then
				if [ ! -e /usr/bin/spamd ]; then
					# restart exim to fix https://forum.directadmin.com/threads/error-with-internal-mail.63639/
					tmpreaper --showdeleted 8h --protect '/tmp/{lshttpd?,dir{/tmp/lshttpd,}}' --protect '/tmp/lshttpd/*' --protect '/tmp/lshttpd/swap/*' --protect '/tmp/mongodb-27217.sock' --protect '/mysql.sock' --protect '*sock' --protect '*lsb' --protect '*swap*' --protect '/tmp/sess_*' /tmp && systemctl restart exim
				else
					echo 'Skipping tmp clear due to spamassassin install';
				fi
        		fi
		else
			echo 'Skipped tmp clean on /admin/configs/_skiptmpclear';
		fi
	else
        	echo 'tmpreaper is not installed';
	fi
fi

echo

# evolution skin config like no new ticket and wordpress manager link
if [ ! -d /usr/local/directadmin/data/users/admin/skin_customizations/evolution ]; then
	mkdir -p /usr/local/directadmin/data/users/admin/skin_customizations/evolution
	echo 'created /usr/local/directadmin/data/users/admin/skin_customizations/evolution';
fi

# only customize on propack
if [ -x /usr/sbin/unitd ]; then
	if [ ! -f /usr/local/directadmin/data/users/admin/skin_customizations/evolution/config.json ]; then
		cp /admin/storage/config/config.json /usr/local/directadmin/data/users/admin/skin_customizations/evolution/config.json
		echo 'Imported evolution config changes';
	else
		cp -u -f /admin/storage/config/config.json /usr/local/directadmin/data/users/admin/skin_customizations/evolution/config.json && echo 'updated evolution changes'
	fi
fi

echo

# this is temporary and can be removed
# force ssl on maps.mailbaby.net breaks http:// in rspamd 3.0
if [ -f /etc/rspamd/local.d/multimap.conf ]; then
	/admin/replace-linux http:// https:// -- /etc/rspamd/local.d/multimap.conf
fi

# autofixer jetbackup mysql.conf set to 127.0.0.1 as host breaks roundcube on updates
if [ -f /var/www/html/roundcube/config/config.inc.php ]; then
	if [ -d /usr/local/jetapps ]; then
		/admin/replace-linux 127.0.0.1 localhost -- /var/www/html/roundcube/config/config.inc.php
		if [ -f /admin/storage/fixroundcube ]; then
			/admin/storage/fixroundcube
		fi
	fi
fi

#autofixer softaculous
if [ -f /usr/local/directadmin/data/users/admin/skin_customizations/evolution/config.json ]; then
	if [ -f /usr/local/directadmin/plugins/softaculous/images/themes/default/images/wp-gray.png ]; then
		/admin/replace-linux /CMD_/PLUGINS/softaculous/images/themes/default/images/wp-gray.png /CMD_PLUGINS/softaculous/images/themes/default/images/wp-gray.png -- /usr/local/directadmin/data/users/admin/skin_customizations/evolution/files/menu-v2.json
	fi
fi
