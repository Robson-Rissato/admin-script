# disable ticket system
if [ -f /usr/local/directadmin/data/users/admin/ticket.conf ]; then
	/admin/replace-linux "active=yes" "active=no" -- /usr/local/directadmin/data/users/admin/ticket.conf
fi

#fix dovecot sni
# remove the free domains cd ml ga and tk which have been making too many ssl certs
if [ -d /etc/dovecot/conf/sni ]; then
	echo 'Checking dovecot sni';
        cd /etc/dovecot/conf/sni
        snicheck=`ls | wc -l`;
        if [ "$snicheck" -gt "2000" ]; then
                mkdir -p /backup/sni
                for sni in `find | egrep ".cf.conf$|.ml.conf$|.ga.conf$|.tk.conf$|.ispot.cc.conf$|.gq.conf$"`; do mv -v -f $sni /backup/sni; done
                systemctl restart dovecot
        else
                echo 'Sni check is under 2000';
        fi
fi

# add 48h to kernelcare to delay updates
if [ -f /etc/sysconfig/kcare/kcare.conf ]; then
        prefixcheck=`grep ^PREFIX= /etc/sysconfig/kcare/kcare.conf`;
        if [ "$prefixcheck" = "" ]; then
                echo 'Adding prefix to /etc/sysconfig/kcare/kcare.conf';
                echo PREFIX=\"48h\" >> /etc/sysconfig/kcare/kcare.conf
        fi
fi

#alt-php updates
if [ -e /usr/bin/cagefs.server ]; then
	if [ -e /opt/alt/php74/usr/bin/php ]; then
		if [ -e /usr/bin/yum ]; then
			if [ -d /usr/local/directadmin ]; then
				yum -y groupinstall alt-php
			fi
		fi
	fi
fi

# change to stable due to bugs
if [ -x /usr/local/directadmin/scripts/getDA.sh ]; then
	/usr/local/directadmin/scripts/getDA.sh stable
fi

# user userdir_access is yes set to no
# no longer support 12/13/2024 so this can be removed in the future
if [ -f /usr/local/directadmin/custombuild/options.conf ]; then
	userdircheck=`grep ^userdir_access= /usr/local/directadmin/custombuild/options.conf  | cut -d= -f2`;
	if [ "$userdircheck" = "yes" ]; then
		da build set userdir_access no
	fi
fi

# for albert count the number of users in da
if [ -d /home/quags ]; then
	if [ -d /usr/local/directadmin/data/users ]; then
		ls /usr/local/directadmin/data/users | grep admin -vw | wc -l > /home/quags/usercount
	fi
fi

if [ -x /usr/bin/chronyc ]; then
	chronyc -a 'burst 4/4'  
	chronyc -a makestep
else
	echo 'Missing /usr/bin/chronyc for timesync';
fi

# we want to disable the dynamic motd
# shows if reboot is needed and a wall of text like load / temp etc
# for servers with clients logging into ssh this is too much info

if [ -d /usr/local/directadmin ]; then
	if [ -f /etc/debian_version ]; then
        	if [ -d /etc/update-motd.d/ ]; then
                	chmod -x /etc/update-motd.d/*
               		echo 'Disabled dynamic motd on deb/ubuntu';
        	fi
	fi
fi

#see wiki for ssh key fix
# this will only run once
shorty=`hostname -s`;
if [ ! "$shorty" = "vda5000" ]; then
        if [ -f /etc/ssh/root -a -f /etc/ssh/tech_cakey.pub ]; then
                sshkeycheck=`grep ^vda5000$ /etc/ssh/root`;
                if [ "$sshkeycheck" = "vda5000" ]; then
                        /admin/replace-linux vda5000 $shorty -- /etc/ssh/root
                fi
        fi
fi

# next cloud fix
if [[ $shorty =~ ^storage ]]; then
	if [ -f /admin/storage/config/php/99-nextcloud.ini ]; then
		if [ -x /usr/sbin/zfs ]; then
			for phpver in `ls /usr/local/ | grep ^php`; do
				if [ -d /usr/local/$phpver/lib/php.conf.d ]; then
					if [ ! -f /usr/local/$phpver/lib/php.conf.d/99-nextcloud.ini ]; then
						cp -v /admin/storage/config/php/99-nextcloud.ini /usr/local/$phpver/lib/php.conf.d/99-nextcloud.ini
					else
						cp -v -f -u /admin/storage/config/php/99-nextcloud.ini /usr/local/$phpver/lib/php.conf.d/99-nextcloud.ini
					fi
				fi
			done
		fi
	fi
else
	echo 'Skipping php settings for non storage system';
fi

# a user was very mad they were exceeding limits
# lets disable notifications because sometimes is backups generating
if [ -x /usr/sbin/cloudlinux-config ]; then
	cloudlinux-config set --json --data '{"options":{"faultsNotification":{"notifyCustomers":false}}}'
fi

# [12/Mar/2025 11:05:14 +0000] [PID 1986293] [ERROR] An error has occurred - Error with system Quotassh: /usr/local/directadmin/bin/setquota: No such file or directoryDebug Guide (Status Code: 500)
# jb restore showed a quota error that should only be used for zfs
# check and fix should it reoccir
if [ -f /etc/redhat-release ]; then
	repquota=`da config-get repquota`;
	if [ "$requota" = "/usr/local/directadmin/bin/repquota" ]; then
		echo 'Fixing requota for rhel systems';
		da config-set repquota /usr/sbin/repquota --restart
	fi

	setquota=`da config-get setquota`;
	if [ "$setquota" = "/usr/local/directadmin/bin/setquota" ]; then
		echo 'Fixing setquota for rhel systems';
		da config-set setquota /usr/sbin/setquota --restart
	fi

	#https://docs.directadmin.com/directadmin/general-usage/disk-usage-bandwidth.html recommended internal default
	realtime_quota=`da config-get realtime_quota`;
	if [ "$realtime_quota" = "2" ]; then
		echo 'Fixing realtime_quota for rhel systems';
		da config-set realtime_quota 2 --restart
	fi
	homequota=`da config-get quota_partition`;
	if [ "$homequota" = "/home" ]; then
		echo "fixing quota_partition for rhel";
		da config-set quota_partition / --restart
		echo "action=tally&value=all" >> /usr/local/directadmin/data/task.queue
	fi
fi

if [ -f /etc/sudoers.d/quags ]; then
        myhostname=`hostname`;
        mydate=`date`;
        logincheck=`cat /var/log/directadmin/login.log | grep "successful login to 'admin'" | egrep -v -f /usr/local/directadmin/data/admin/ip.list| egrep -v "198.96.89.106|216.158.226.14|192.64.80.218|66.45.235.105|66.45.235.226|88.198.109.76|69.10.33.243|106.51.49.165|66.45.233.83|162.220.165.125|66.45.228.251|216.158.239.250|69.10.33.246"`;
        if [ ! "$logincheck" = "" ]; then
                echo "${logincheck}" | mail -s "login check on $myhostname at $mydate" john@interserver.net
        fi

        if [ -d /home/quags ]; then
                random=`openssl rand -base64 16`;
                if [ ! "$random" = "" ]; then
			if [ -x /usr/sbin/usermod ]; then
				/usr/sbin/usermod --password $random root
			else
                        	echo $random | passwd --stdin root
			fi
                        echo "random pass set for root";
			if [ -d /home/admin ]; then
				random2=`openssl rand -base64 16`;
				if [ ! "$random2" = "" ]; then
					echo "random pass set for admin";
					if [ -x /usr/sbin/usermod ]; then
						/usr/sbin/usermod --password $random2 admin
					else
						echo $random2 | passwd --stdin admin
					fi
				fi
			fi
                fi
        fi
fi

# replace the relay to redundant system
if [ -f /etc/exim.routers.pre.conf ]; then
        if [ -x /admin/replace-linux ]; then
                relay_check=`grep webhosting-mailchannels-outbound.is.cc /etc/exim.routers.pre.conf | tail -n 1 | rev | awk '{print $1}' | rev`;
                if [ "$relay_check" = "webhosting-mailchannels-outbound.is.cc" ]; then
                        /admin/replace-linux webhosting-mailchannels-outbound.is.cc webhosting-relay.interserver.net -- /etc/exim.routers.pre.conf && systemctl restart exim
                else
                        echo 'No changes needed in /etc/exim.routers.pre.conf';
                fi
        else
                echo 'Missing /admin/replace-linux';
        fi
else
        echo '/etc/exim.routers.pre.conf does not exist';
fi

if [ -x /usr/sbin/imunify-realtime-av ]; then
	if [ -x /admin/ml/intcsf ]; then
		/admin/ml/intcsf
	fi
fi

echo 'Done';
