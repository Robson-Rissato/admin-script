<?xml version="1.0" encoding="UTF-8"?>
<httpServerConfig>
  <serverName>$HOSTNAME</serverName>
  <user>nobody</user>
  <group>nobody</group>
  <priority>0</priority>
  <cpuAffinity>1</cpuAffinity>
  <chrootPath>/</chrootPath>
  <enableChroot>0</enableChroot>
  <enableLVE>2</enableLVE>
  <inMemBufSize>8192M</inMemBufSize>
  <swappingDir>/tmp/lshttpd/swap</swappingDir>
  <autoFix503>0</autoFix503>
  <enableh2c>1</enableh2c>
  <loadApacheConf>1</loadApacheConf>
  <autoReloadApacheConf>2</autoReloadApacheConf>
  <apacheBinPath>/usr/sbin/httpd</apacheBinPath>
  <apacheConfFile>/etc/apache2/conf/httpd.conf</apacheConfFile>
  <apachePortOffset>0</apachePortOffset>
  <apacheIpOffset>0</apacheIpOffset>
  <apacheIgnoredModules>bwlimited_module</apacheIgnoredModules>
  <jitConfig>1</jitConfig>
  <phpSuExec>1</phpSuExec>
  <phpSuExecMaxConn>15</phpSuExecMaxConn>
  <apacheEnableFP>0</apacheEnableFP>
  <mime>$SERVER_ROOT/conf/mime.properties</mime>
  <disableInitLogRotation>1</disableInitLogRotation>
  <showVersionNumber>0</showVersionNumber>
  <useIpInProxyHeader>2</useIpInProxyHeader>
  <autoUpdateInterval>86400</autoUpdateInterval>
  <autoUpdateDownloadPkg>1</autoUpdateDownloadPkg>
  <adminEmails>root@localhost</adminEmails>
  <adminRoot>$SERVER_ROOT/admin/</adminRoot>
  <logging>
    <log>
      <fileName>/var/log/apache2/error_log</fileName>
      <logLevel>DEBUG</logLevel>
      <debugLevel>0</debugLevel>
      <rollingSize>2000M</rollingSize>
      <enableStderrLog>1</enableStderrLog>
      <enableAioLog>1</enableAioLog>
    </log>
    <accessLog>
      <fileName>$SERVER_ROOT/logs/access.log</fileName>
      <rollingSize>2000M</rollingSize>
      <keepDays>30</keepDays>
      <compressArchive>1</compressArchive>
    </accessLog>
  </logging>
  <indexFiles>index.html, index.php, index.htm</indexFiles>
  <htAccess>
    <allowOverride>31</allowOverride>
    <accessFileName>.htaccess</accessFileName>
  </htAccess>
  <expires>
    <enableExpires>1</enableExpires>
    <expiresByType>image/*=A604800, text/css=A604800, application/x-javascript=A604800, application/javascript=A604800</expiresByType>
  </expires>
  <ipToGeo>
    <geoipDB>
      <geoipDBFile>/usr/share/GeoIP/GeoIP.dat</geoipDBFile>
      <geoipDBCache>MemoryCache</geoipDBCache>
    </geoipDB>
  </ipToGeo>
  <tuning>
    <eventDispatcher>best</eventDispatcher>
    <ramDiskPath>/dev/shm/</ramDiskPath>
    <shmDefaultDir>/dev/shm</shmDefaultDir>
    <maxConnections>3000</maxConnections>
    <maxSSLConnections>3000</maxSSLConnections>
    <connTimeout>160</connTimeout>
    <maxKeepAliveReq>1000</maxKeepAliveReq>
    <smartKeepAlive>1</smartKeepAlive>
    <keepAliveTimeout>5</keepAliveTimeout>
    <sndBufSize>0</sndBufSize>
    <rcvBufSize>0</rcvBufSize>
    <maxReqURLLen>8192</maxReqURLLen>
    <maxReqHeaderSize>16380</maxReqHeaderSize>
    <maxReqBodySize>500M</maxReqBodySize>
    <maxDynRespHeaderSize>8K</maxDynRespHeaderSize>
    <maxDynRespSize>500M</maxDynRespSize>
    <maxCachedFileSize>8192</maxCachedFileSize>
    <totalInMemCacheSize>200M</totalInMemCacheSize>
    <maxMMapFileSize>512K</maxMMapFileSize>
    <totalMMapCacheSize>400M</totalMMapCacheSize>
    <useSendfile>1</useSendfile>
    <useAIO>1</useAIO>
    <AIOBlockSize>7</AIOBlockSize>
    <fileETag>24</fileETag>
    <enableGzipCompress>1</enableGzipCompress>
    <enableDynGzipCompress>1</enableDynGzipCompress>
    <gzipCompressLevel>1</gzipCompressLevel>
    <compressibleTypes>text/*, application/x-javascript, application/xml, application/javascript, image/svg+xml</compressibleTypes>
    <gzipAutoUpdateStatic>1</gzipAutoUpdateStatic>
    <gzipCacheDir>/dev/shm</gzipCacheDir>
    <gzipStaticCompressLevel>1</gzipStaticCompressLevel>
    <gzipMaxFileSize>1M</gzipMaxFileSize>
    <gzipMinFileSize>300</gzipMinFileSize>
    <enableBrCompress>1</enableBrCompress>
    <brStaticCompressLevel>1</brStaticCompressLevel>
    <SSLCryptoDevice>null</SSLCryptoDevice>
    <sslSessionCache>1</sslSessionCache>
    <sslSessionTickets>1</sslSessionTickets>
  </tuning>
  <quic>
    <quicEnable>1</quicEnable>
    <quicShmDir>/dev/shm</quicShmDir>
  </quic>
  <security>
    <fileAccessControl>
      <followSymbolLink>1</followSymbolLink>
      <checkSymbolLink>0</checkSymbolLink>
      <forceStrictOwnership>1</forceStrictOwnership>
      <requiredPermissionMask>000</requiredPermissionMask>
      <restrictedPermissionMask>000</restrictedPermissionMask>
      <restrictedScriptPermissionMask>000</restrictedScriptPermissionMask>
      <restrictedDirPermissionMask>000</restrictedDirPermissionMask>
    </fileAccessControl>
    <perClientConnLimit>
      <staticReqPerSec>200</staticReqPerSec>
      <dynReqPerSec>200</dynReqPerSec>
      <outBandwidth>0</outBandwidth>
      <inBandwidth>0</inBandwidth>
      <softLimit>10000</softLimit>
      <hardLimit>10000</hardLimit>
      <blockBadReq>1</blockBadReq>
      <gracePeriod>15</gracePeriod>
      <banPeriod>300</banPeriod>
    </perClientConnLimit>
    <CGIRLimit>
      <maxCGIInstances>200</maxCGIInstances>
      <minUID>11</minUID>
      <minGID>10</minGID>
      <priority>0</priority>
      <CPUSoftLimit>60</CPUSoftLimit>
      <CPUHardLimit>120</CPUHardLimit>
      <memSoftLimit>1450M</memSoftLimit>
      <memHardLimit>1500M</memHardLimit>
      <procSoftLimit>1400</procSoftLimit>
      <procHardLimit>1450</procHardLimit>
    </CGIRLimit>
    <censorshipControl>
      <enableCensorship>0</enableCensorship>
      <logLevel>0</logLevel>
      <defaultAction>deny,log,status:403</defaultAction>
      <scanPOST>1</scanPOST>
    </censorshipControl>
    <accessDenyDir>
      <dir>/</dir>
      <dir>/etc/*</dir>
      <dir>/dev/*</dir>
      <dir>$SERVER_ROOT/conf/*</dir>
      <dir>$SERVER_ROOT/admin/conf/*</dir>
    </accessDenyDir>
    <accessControl>
      <allow>ALL, 103.21.244.0/22T, 103.22.200.0/22T, 103.31.4.0/22T, 104.16.0.0/12T, 108.162.192.0/18T, 131.0.72.0/22T, 141.101.64.0/18T, 162.158.0.0/15T, 172.64.0.0/13T, 173.245.48.0/20T, 188.114.96.0/20T, 190.93.240.0/20T, 197.234.240.0/22T, 198.41.128.0/17T, 199.83.128.0/21T, 198.143.32.0/19T, 149.126.72.0/21T, 103.28.248.0/22T, 45.64.64.0/22T, 185.11.124.0/22T, 192.230.64.0/18T, 107.154.0.0/16T, 45.60.0.0/16T, 45.223.0.0/16T, 64.20.33.162T, 66.45.228.251T, 5.172.196.188T, 5.178.78.77T, 13.232.220.164T, 23.22.2.46T, 23.83.129.219T, 23.111.152.74T, 23.111.159.174T, 27.122.14.7T, 37.252.231.50T, 43.225.198.122T, 43.229.84.12T, 46.20.45.18T, 46.165.195.139T, 50.16.153.186T, 50.23.28.35T, 52.0.204.16T, 52.24.42.103T, 52.48.244.35T, 52.52.34.158T, 52.52.95.213T, 52.52.118.192T, 52.57.132.90T, 52.59.46.112T, 52.59.147.246T, 52.62.12.49T, 52.63.142.2T, 52.63.164.147T, 52.63.167.55T, 52.67.148.55T, 52.73.209.122T, 52.89.43.70T, 52.194.115.181T, 52.197.31.124T, 52.197.224.235T, 52.198.25.184T, 52.201.3.199T, 52.209.34.226T, 52.209.186.226T, 52.210.232.124T, 54.68.48.199T, 54.70.202.58T, 54.94.206.111T, 64.237.49.203T, 64.237.55.3T, 66.165.229.130T, 66.165.233.234T, 69.59.28.19T, 72.46.140.106T, 72.46.153.26T, 76.72.167.90T, 76.72.167.154T, 76.72.172.208T, 76.164.194.74T, 76.164.234.106T, 76.164.234.170T, 81.17.62.205T, 82.103.136.16T, 82.103.139.165T, 82.103.145.126T, 83.170.113.210T, 85.17.156.11T, 85.17.156.76T, 85.93.93.123T, 85.93.93.124T, 85.93.93.133T, 89.163.146.247T, 89.163.242.206T, 94.75.211.73T, 94.75.211.74T, 94.247.174.83T, 95.141.32.46T, 95.211.198.87T, 96.47.225.18T, 103.47.211.210T, 104.129.24.154T, 104.129.30.18T, 109.123.101.103T, 138.219.43.186T, 159.8.146.132T, 162.218.67.34T, 168.1.92.58T, 169.51.2.22T, 169.51.80.85T, 172.241.112.86T, 173.248.147.18T, 173.254.206.242T, 174.34.156.130T, 174.34.224.167T, 175.45.132.20T, 178.255.152.2T, 178.255.153.2T, 178.255.154.2T, 178.255.155.2T, 179.50.12.212T, 184.75.208.210T, 184.75.209.18T, 184.75.210.90T, 184.75.210.226T, 184.75.214.66T, 185.39.146.214T, 185.39.146.215T, 185.70.76.23T, 185.93.3.92T, 185.152.65.167T, 185.180.12.65T, 185.246.208.82T, 188.138.40.20T, 188.172.252.34T, 199.87.228.66T, 201.33.21.5T, 207.244.80.239T, 208.64.28.194T, 209.58.139.193T, 209.58.139.194T, 209.126.117.87T, 209.126.120.29T, 211.44.63.35T</allow>
    </accessControl>
  </security>
  <extProcessorList>
    <extProcessor>
      <type>lsapi</type>
      <name>cl_phpselector</name>
      <address>uds://tmp/lshttpd/cl_phpselector.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/usr/local/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp54</name>
      <address>uds://tmp/lshttpd/lsphp54.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php54/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp55</name>
      <address>uds://tmp/lshttpd/lsphp55.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php55/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp56</name>
      <address>uds://tmp/lshttpd/lsphp56.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php56/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp70</name>
      <address>uds://tmp/lshttpd/lsphp70.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php70/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp71</name>
      <address>uds://tmp/lshttpd/lsphp71.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php71/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>lsphp72</name>
      <address>uds://tmp/lshttpd/lsphp72.sock</address>
      <maxConns>100</maxConns>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>3</autoStart>
      <path>/opt/cpanel/ea-php72/root/usr/bin/lsphp</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
    <extProcessor>
      <type>lsapi</type>
      <name>phpmmdrop</name>
      <address>uds://tmp/lshttpd/fastphp.sock</address>
      <maxConns>100</maxConns>
      <env>LSAPI_LVE_ENABLE=3</env>
      <env>PHP_LSAPI_MAX_REQUESTS=5000</env>
      <env>PHP_LSAPI_CHILDREN=100</env>
      <initTimeout>60</initTimeout>
      <retryTimeout>0</retryTimeout>
      <persistConn>1</persistConn>
      <respBuffer>0</respBuffer>
      <autoStart>1</autoStart>
      <path>/opt/cpanel/ea-php71/root/usr/bin/lsphp -c /opt/cpanel/ea-php71/root/etc/phpint.ini</path>
      <backlog>100</backlog>
      <instances>1</instances>
      <runOnStartUp>2</runOnStartUp>
      <extMaxIdleTime>70</extMaxIdleTime>
      <priority>0</priority>
      <memSoftLimit>2047M</memSoftLimit>
      <memHardLimit>2047M</memHardLimit>
      <procSoftLimit>400</procSoftLimit>
      <procHardLimit>500</procHardLimit>
    </extProcessor>
  </extProcessorList>
  <scriptHandlerList>
    <scriptHandler>
      <suffix>php</suffix>
      <type>lsapi</type>
      <handler>cl_phpselector</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php5</suffix>
      <type>lsapi</type>
      <handler>cl_phpselector</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php54</suffix>
      <type>lsapi</type>
      <handler>lsphp54</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php55</suffix>
      <type>lsapi</type>
      <handler>lsphp55</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php56</suffix>
      <type>lsapi</type>
      <handler>lsphp56</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php70</suffix>
      <type>lsapi</type>
      <handler>lsphp70</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php71</suffix>
      <type>lsapi</type>
      <handler>lsphp71</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>php72</suffix>
      <type>lsapi</type>
      <handler>lsphp72</handler>
    </scriptHandler>
    <scriptHandler>
      <suffix>fastphp</suffix>
      <type>lsapi</type>
      <handler>phpmmdrop</handler>
      <note>phpmmdrop</note>
    </scriptHandler>
  </scriptHandlerList>
  <modpagespeed>
    <activate>0</activate>
    <enabled>0</enabled>
  </modpagespeed>
  <railsDefaults>
    <rubyBin>/usr/local/lsws/fcgi-bin/ea-ruby24</rubyBin>
    <railsEnv>1</railsEnv>
    <maxConns>5</maxConns>
    <env>LSAPI_MAX_REQS=1000</env>
    <env>LSAPI_MAX_IDLE=60</env>
    <initTimeout>60</initTimeout>
    <retryTimeout>0</retryTimeout>
    <pcKeepAliveTimeout>60</pcKeepAliveTimeout>
    <respBuffer>0</respBuffer>
    <backlog>50</backlog>
    <runOnStartUp>1</runOnStartUp>
    <extMaxIdleTime>300</extMaxIdleTime>
    <priority>3</priority>
    <memSoftLimit>2047M</memSoftLimit>
    <memHardLimit>2047M</memHardLimit>
    <procSoftLimit>400</procSoftLimit>
    <procHardLimit>500</procHardLimit>
  </railsDefaults>
  <listenerList>
    <listener>
      <name>80</name>
      <address>*:80</address>
      <binding>3</binding>
      <secure>0</secure>
    </listener>
    <listener>
      <name>443</name>
      <address>*:443</address>
      <binding>3</binding>
      <secure>0</secure>
    </listener>
  </listenerList>
</httpServerConfig>
